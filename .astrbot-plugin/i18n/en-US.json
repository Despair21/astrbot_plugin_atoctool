{
  "metadata": {
    "display_name": "Game Activity Calendar",
    "short_desc": "Sync six game activity calendars and remind before they end",
    "desc": "Persist per-game activity snapshots, merge activities across sources, and support /activity commands, a Dashboard view, and pre-end reminders."
  },
  "config": {
    "general": {
      "description": "General settings",
      "enabled": {
        "description": "Enable the plugin"
      },
      "sync_interval_minutes": {
        "description": "Auto sync interval (minutes)"
      },
      "request_timeout_seconds": {
        "description": "Request timeout (seconds)"
      },
      "max_response_kb": {
        "description": "Response size limit (KB)"
      },
      "use_t2i": {
        "description": "Try rendering long results as images"
      }
    },
