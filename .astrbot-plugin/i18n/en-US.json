            "description": "Game name (used to derive game_id)"
          },
          "url": {
            "description": "JSON URL"
          },
          "adapter": {
            "description": "Adapter"
          },
          "priority": {
            "description": "Primary source priority"
          },
          "timezone": {
            "description": "Source time zone"
          },
          "map_activities": {
            "description": "Activities array path"
          },
          "map_name": {
            "description": "Name path"
          },
          "map_description": {
            "description": "Description path"
          },
          "map_start": {
            "description": "Start time path"
          },
          "map_end": {
            "description": "End time path"
          },
          "map_cover": {
            "description": "Cover path"
          },
          "map_kind": {
            "description": "Kind path (optional)"
          },
          "map_version": {
            "description": "Version path (optional)"
          },
          "map_version_name": {
            "description": "Version name path (optional)"
          }
        }
      }
    },
    "reminder": {
      "description": "Reminder settings",
      "enabled": {
        "description": "Enable pre-end reminders"
      },
      "remind_days_before": {
        "description": "Days before the end (comma separated)",
        "hint": "For example 3,1 reminds 3 days and 1 day before the end"
      },
      "remind_time": {
        "description": "Reminder time (HH:MM, source time zone)"
      },
      "max_grace_hours": {
        "description": "Grace window (hours, 0 = no catch-up)"
      },
      "target_umos": {
        "description": "Fixed reminder sessions",
        "hint": "Leave empty to use the sessions subscribed via /activity subscribe"
      },
      "max_sends_per_tick": {
        "description": "Max sessions per tick"
      }
